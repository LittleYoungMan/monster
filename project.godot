[layer_names]

2d_physics/layer_1="PLAYER  玩家本体"
2d_physics/layer_2="ENEMY  敌人本体"
2d_physics/layer_3="PLAYER_PROJECTILE   玩家投射物/武器攻击范围"
2d_physics/layer_4="ENEMY_PROJECTILE    敌人投射物/攻击范围"
2d_physics/layer_5="PICKUP拾取物   （金币、矿石、血瓶）"
2d_physics/layer_6="WALL地图边界、障碍物"
2d_physics/layer_7="SHOP_DOOR   商店门碰撞体"
2d_physics/layer_8="FORGE_DOOR   工坊门碰撞体"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
